<Window x:Class="Hearthline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hearthline | Building Operations"
        Width="1440" Height="920" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Canvas}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource Forest}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="22,24,22,18">
          <TextBlock Text="Hearthline" FontSize="25" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="BUILDING OPERATIONS" FontSize="10" FontWeight="SemiBold" Foreground="#A8C4B7" Margin="1,4,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="16,12,16,20">
          <Border Background="#25534B" CornerRadius="6" Padding="12,10">
            <StackPanel>
              <TextBlock Text="SERVICE STATUS" FontSize="9" FontWeight="Bold" Foreground="#A8C4B7" />
              <TextBlock x:Name="StatusText" Text="Demo mode - local data" FontSize="12" Foreground="White" Margin="0,5,0,0" TextWrapping="Wrap" />
              <Button Content="Test connection" Click="CheckConnection_Click" HorizontalAlignment="Left" Background="Transparent" Foreground="#D8E7DF" BorderThickness="0" Padding="0" Margin="0,8,0,0" FontSize="10" Cursor="Hand" />
            </StackPanel>
          </Border>
          <TextBlock Text="HARBOR HOUSE  |  2026" FontSize="9" Foreground="#89AA9D" Margin="4,14,0,0" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,8,12,8">
            <TextBlock Text="BUILDING" FontSize="9" FontWeight="Bold" Foreground="#89AA9D" Margin="10,4,0,8" />
            <Button x:Name="NavOverview" Tag="Overview" Content="Overview" Click="Navigation_Click" Style="{StaticResource NavButton}" />
            <Button x:Name="NavResidents" Tag="Residents" Content="Residents" Click="Navigation_Click" Style="{StaticResource NavButton}" />
            <Button x:Name="NavApartments" Tag="Apartments" Content="Apartments" Click="Navigation_Click" Style="{StaticResource NavButton}" />
            <TextBlock Text="OPERATIONS" FontSize="9" FontWeight="Bold" Foreground="#89AA9D" Margin="10,20,0,8" />
            <Button x:Name="NavMaintenance" Tag="Maintenance" Content="Maintenance" Click="Navigation_Click" Style="{StaticResource NavButton}" />
            <Button x:Name="NavGuests" Tag="Guest passes" Content="Guest passes" Click="Navigation_Click" Style="{StaticResource NavButton}" />
            <TextBlock Text="COMMUNITY" FontSize="9" FontWeight="Bold" Foreground="#89AA9D" Margin="10,20,0,8" />
            <Button x:Name="NavAnnouncements" Tag="Announcements" Content="Announcements" Click="Navigation_Click" Style="{StaticResource NavButton}" />
            <Button x:Name="NavEvents" Tag="Events" Content="Events" Click="Navigation_Click" Style="{StaticResource NavButton}" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="82" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
        <Grid Margin="28,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="145" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="Overview" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}" />
            <TextBlock x:Name="PageSubtitle" Text="A clear view of today's building operations." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
          </StackPanel>
          <TextBox x:Name="SearchBox" Grid.Column="1" Height="36" VerticalContentAlignment="Center" Padding="11,0" Margin="0,0,12,0" FontSize="12" TextChanged="SearchBox_TextChanged" ToolTip="Search the current view" />
          <Button x:Name="RoleButton" Grid.Column="2" Content="Admin view" Click="RoleButton_Click" Background="#E6F0EA" Foreground="#214D42" BorderThickness="0" FontWeight="SemiBold" FontSize="11" Padding="12,8" VerticalAlignment="Center" Cursor="Hand" />
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ContentControl x:Name="PageHost" />
      </ScrollViewer>
    </Grid>
  </Grid>
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="#D8E7DF" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="NavSurface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavSurface" Property="Background" Value="#25534B" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
</Window>